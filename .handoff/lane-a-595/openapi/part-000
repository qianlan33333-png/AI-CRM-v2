openapi: 3.0.3
info:
  title: AI-CRM v2 API
  version: 0.6.0-p3-segment-contract
  description: Canonical HTTP contract. Generated code must not be edited. P3-I00 freezes fail-closed identity semantics and P3-S00 freezes Segment DSL v1 before implementation begins.
security:
  - AdminSession: []
paths:
  /api/v1/products:
    get:
      tags: [p4-product]
      operationId: listProducts
      summary: List ordinary products using a keyset cursor
      x-legacy-mapping-ids: [LEGACY-API-0525]
      x-p4-decision-evidence: P4-I01A-2026-08-14
      x-aicrm-capability: products.read
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: none
      x-aicrm-data-classification: financial
      x-aicrm-external-effect: none
      parameters: [{$ref: "#/components/parameters/Cursor"}, {$ref: "#/components/parameters/Limit"}]
      responses:
        "200": {description: Product page, content: {application/json: {schema: {$ref: "#/components/schemas/ProductPage"}}}}
        "400": {$ref: "#/components/responses/BadRequest"}
        "401": {$ref: "#/components/responses/Unauthorized"}
        "403": {$ref: "#/components/responses/Forbidden"}
        "503": {$ref: "#/components/responses/ServiceUnavailable"}
    post:
      tags: [p4-product]
      operationId: createProduct
      summary: Create one ordinary product
      x-legacy-mapping-ids: [LEGACY-API-0526]
      x-p4-decision-evidence: P4-I01A-2026-08-14
      x-aicrm-capability: products.write
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: required
      x-aicrm-data-classification: financial
      x-aicrm-data-source: local_command
      x-aicrm-external-effect: none
      parameters: [{$ref: "#/components/parameters/CSRFToken"}, {$ref: "#/components/parameters/IdempotencyKey"}]
      requestBody: {required: true, content: {application/json: {schema: {$ref: "#/components/schemas/CreateProductRequest"}}}}
      responses:
        "201": {description: Product created, content: {application/json: {schema: {$ref: "#/components/schemas/Product"}}}}
        "400": {$ref: "#/components/responses/BadRequest"}
        "401": {$ref: "#/components/responses/Unauthorized"}
        "403": {$ref: "#/components/responses/Forbidden"}
        "409": {$ref: "#/components/responses/Conflict"}
        "503": {$ref: "#/components/responses/ServiceUnavailable"}
  /api/v1/products/{product_id}:
    get:
      tags: [p4-product]
      operationId: getProduct
      summary: Get one ordinary product
      x-legacy-mapping-ids: [LEGACY-API-0530]
      x-p4-decision-evidence: P4-I01A-2026-08-14
      x-aicrm-capability: products.read
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: none
      x-aicrm-data-classification: financial
      x-aicrm-data-source: local_read_model
      x-aicrm-external-effect: none
      parameters: [{$ref: "#/components/parameters/ProductID"}]
      responses:
        "200": {description: Product, content: {application/json: {schema: {$ref: "#/components/schemas/Product"}}}}
        "400": {$ref: "#/components/responses/BadRequest"}
        "401": {$ref: "#/components/responses/Unauthorized"}
        "403": {$ref: "#/components/responses/Forbidden"}
        "404": {$ref: "#/components/responses/NotFound"}
        "503": {$ref: "#/components/responses/ServiceUnavailable"}
    put:
      tags: [p4-product]
      operationId: updateProduct
      summary: Update one local ordinary product using optimistic concurrency
      x-p4-decision-evidence: P4-PRODUCT-ENTITLEMENT-PACKAGE-2026-08-20
      x-aicrm-capability: products.write
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: required
      x-aicrm-data-classification: financial
      x-aicrm-data-source: local_command
      x-aicrm-external-effect: none
      parameters: [{$ref: "#/components/parameters/ProductID"}, {$ref: "#/components/parameters/CSRFToken"}, {$ref: "#/components/parameters/IdempotencyKey"}]
      requestBody: {required: true, content: {application/json: {schema: {$ref: "#/components/schemas/UpdateProductRequest"}}}}
      responses:
        "200": {description: Updated local product, content: {application/json: {schema: {$ref: "#/components/schemas/Product"}}}}
        "400": {$ref: "#/components/responses/BadRequest"}
        "401": {$ref: "#/components/responses/Unauthorized"}
        "403": {$ref: "#/components/responses/Forbidden"}
        "404": {$ref: "#/components/responses/NotFound"}
        "409": {$ref: "#/components/responses/Conflict"}
        "503": {$ref: "#/components/responses/ServiceUnavailable"}
  /api/v1/products/{product_id}/local-entitlements:
    get:
      tags: [p4-product-entitlement]
      operationId: listProductLocalEntitlements
      summary: List local product entitlements without invoking payment or providers
      x-p4-decision-evidence: P4-PRODUCT-ENTITLEMENT-PACKAGE-2026-08-20
      x-aicrm-capability: entitlements.read
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: none
      x-aicrm-data-classification: internal_pii
      x-aicrm-data-source: local_read_model
      x-aicrm-external-effect: none
      parameters: [{$ref: "#/components/parameters/ProductID"}, {$ref: "#/components/parameters/EntitlementLimit"}]
      responses:
        "200": {description: Local entitlement list ordered by id descending, content: {application/json: {schema: {$ref: "#/components/schemas/LocalProductEntitlementPage"}}}}
        "400": {$ref: "#/components/responses/BadRequest"}
        "401": {$ref: "#/components/responses/Unauthorized"}
        "403": {$ref: "#/components/responses/Forbidden"}
        "404": {$ref: "#/components/responses/NotFound"}
        "503": {$ref: "#/components/responses/ServiceUnavailable"}
    post:
      tags: [p4-product-entitlement]
      operationId: grantProductLocalEntitlement
      summary: Grant a local entitlement from one existing paid local order projection
      x-p4-decision-evidence: P4-PRODUCT-ENTITLEMENT-PACKAGE-2026-08-20
      x-aicrm-capability: entitlements.write
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: required
      x-aicrm-data-classification: internal_pii
      x-aicrm-data-source: local_command
      x-aicrm-external-effect: none
      parameters: [{$ref: "#/components/parameters/ProductID"}, {$ref: "#/components/parameters/CSRFToken"}, {$ref: "#/components/parameters/IdempotencyKey"}]
      requestBody: {required: true, content: {application/json: {schema: {$ref: "#/components/schemas/GrantProductLocalEntitlementRequest"}}}}
      responses:
        "201": {description: Granted local entitlement, content: {application/json: {schema: {$ref: "#/components/schemas/LocalProductEntitlement"}}}}
        "400": {$ref: "#/components/responses/BadRequest"}
        "401": {$ref: "#/components/responses/Unauthorized"}
        "403": {$ref: "#/components/responses/Forbidden"}
        "404": {$ref: "#/components/responses/NotFound"}
        "409": {$ref: "#/components/responses/Conflict"}
        "503": {$ref: "#/components/responses/ServiceUnavailable"}
  /api/v1/product-entitlements/{entitlement_id}:
    get:
      tags: [p4-product-entitlement]
      operationId: getProductLocalEntitlement
      summary: Get one local product entitlement
      x-p4-decision-evidence: P4-PRODUCT-ENTITLEMENT-PACKAGE-2026-08-20
      x-aicrm-capability: entitlements.read
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: none
      x-aicrm-data-classification: internal_pii
      x-aicrm-data-source: local_read_model
      x-aicrm-external-effect: none
      parameters: [{$ref: "#/components/parameters/EntitlementID"}]
      responses:
        "200": {description: Local entitlement, content: {application/json: {schema: {$ref: "#/components/schemas/LocalProductEntitlement"}}}}
        "400": {$ref: "#/components/responses/BadRequest"}
        "401": {$ref: "#/components/responses/Unauthorized"}
        "403": {$ref: "#/components/responses/Forbidden"}
        "404": {$ref: "#/components/responses/NotFound"}
        "503": {$ref: "#/components/responses/ServiceUnavailable"}
  /api/v1/product-entitlements/{entitlement_id}/revoke:
    post:
      tags: [p4-product-entitlement]
      operationId: revokeProductLocalEntitlement
      summary: Revoke one local entitlement using optimistic concurrency
      x-p4-decision-evidence: P4-PRODUCT-ENTITLEMENT-PACKAGE-2026-08-20
      x-aicrm-capability: entitlements.write
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: required
      x-aicrm-data-classification: internal_pii
      x-aicrm-data-source: local_command
      x-aicrm-external-effect: none
      parameters: [{$ref: "#/components/parameters/EntitlementID"}, {$ref: "#/components/parameters/CSRFToken"}, {$ref: "#/components/parameters/IdempotencyKey"}]
      requestBody: {required: true, content: {application/json: {schema: {$ref: "#/components/schemas/RevokeProductLocalEntitlementRequest"}}}}
      responses:
        "200": {description: Revoked local entitlement, content: {application/json: {schema: {$ref: "#/components/schemas/LocalProductEntitlement"}}}}
        "400": {$ref: "#/components/responses/BadRequest"}
        "401": {$ref: "#/components/responses/Unauthorized"}
        "403": {$ref: "#/components/responses/Forbidden"}
        "404": {$ref: "#/components/responses/NotFound"}
        "409": {$ref: "#/components/responses/Conflict"}
        "503": {$ref: "#/components/responses/ServiceUnavailable"}
  /admin/wechat-pay/products:
    get:
      tags: [p4-product-compat]
      operationId: getLegacyProductListPage
      summary: Redirect the frozen product list entrypoint to the exact local SPA carrier
      x-legacy-mapping-ids: [LEGACY-API-0079]
      x-p4-decision-evidence: P4-I01A-2026-08-14
      x-aicrm-capability: products.read
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: none
      x-aicrm-data-classification: financial
      x-aicrm-external-effect: none
      responses:
        "302":
          description: Exact same-origin SPA carrier redirect; it does not read product data or invoke payment providers.
          headers:
            Location: { required: true, schema: { type: string, enum: ["/?legacy_admin_path=%2Fadmin%2Fwechat-pay%2Fproducts"] } }
            Cache-Control: { required: true, schema: { type: string, enum: ["private, no-store"] } }
            X-Content-Type-Options: { required: true, schema: { type: string, enum: [nosniff] } }
        "401": { $ref: "#/components/responses/Unauthorized" }
        "403": { $ref: "#/components/responses/Forbidden" }
        "405":
          description: Only GET is accepted before authentication.
          headers:
            Allow: { required: true, schema: { type: string, enum: [GET] } }
            Cache-Control: { required: true, schema: { type: string, enum: ["private, no-store"] } }
            X-Content-Type-Options: { required: true, schema: { type: string, enum: [nosniff] } }
  /healthz:
    get:
      tags: [health]
      operationId: getHealthz
      summary: Process liveness
      security: []
      responses:
        "200":
          description: The process is alive.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HealthResponse"
  /health:
    get:
      tags: [p4-legacy-health]
      operationId: getLegacyHealth
      summary: Read the public legacy configuration-derived runtime-mode snapshot
      security: []
      x-legacy-mapping-ids: [LEGACY-API-0757]
      x-p4-decision-evidence: P4-S04-LEGACY-HEALTH-2026-08-18
      x-aicrm-capability: health_read
      x-aicrm-auth-scheme: public
      x-aicrm-csrf: none
      x-aicrm-data-classification: public_non_pii
      x-aicrm-data-source: read_model
      x-aicrm-rate-limit: health
      x-aicrm-external-effect: none
      responses:
        "200":
          description: Runtime-mode snapshot. It is not a liveness, readiness, database, worker, or provider proof.
          content:
            application/json:
              schema: { $ref: "#/components/schemas/LegacyRuntimeHealthSnapshot" }
        "405":
          description: The legacy route only accepts GET.
          headers:
            Allow: { required: true, schema: { type: string, enum: [GET] } }
          content:
            application/json:
              schema: { $ref: "#/components/schemas/LegacyHealthMethodNotAllowed" }
  /api/system/health:
    get:
      tags: [p4-system-health]
      operationId: getSystemHealth
      summary: Read bounded public system readiness without dependency details
      security: []
      x-legacy-mapping-ids: [LEGACY-API-0741]
      x-p4-decision-evidence: P4-SYSTEM-HEALTH-0741-2026-08-17
      x-aicrm-capability: health.read
      x-aicrm-auth-scheme: public
      x-aicrm-csrf: none
      x-aicrm-data-classification: public_non_pii
      x-aicrm-data-source: bounded_read_model
      x-aicrm-external-effect: none
      responses:
        "200":
          description: Required components are ready; warnings may remain.
          headers:
            Cache-Control: { required: true, schema: { type: string, enum: [no-store] } }
          content:
            application/json:
              schema: { $ref: "#/components/schemas/SystemHealthResponse" }
        "503":
          description: One or more required components failed closed.
          headers:
            Cache-Control: { required: true, schema: { type: string, enum: [no-store] } }
          content:
            application/json:
              schema: { $ref: "#/components/schemas/SystemHealthResponse" }
  /{filename}:
    get:
      tags: [p4-domain-verification]
      operationId: getDomainVerificationFile
      summary: Read one WeChat or WeCom domain verification file
      security: []
      x-legacy-mapping-ids: [LEGACY-API-0781]
      x-p4-decision-evidence: P4-S04-DOMAIN-VERIFICATION-2026-08-16
      x-aicrm-capability: domain_verification.read
      x-aicrm-auth-scheme: public
      x-aicrm-csrf: none
      x-aicrm-data-source: static
      x-aicrm-external-effect: none
      parameters:
        - name: filename
          in: path
          required: true
          schema: { type: string, pattern: "^(?:WW|MP)_verify_[A-Za-z0-9_-]+\\.txt$" }
      responses:
        "200":
          description: UTF-8 verification text without surrounding whitespace
          headers:
            Cache-Control:
              required: true
              schema: { type: string, enum: [no-store] }
          content:
            text/plain:
              schema: { type: string }
        "404": { $ref: "#/components/responses/NotFound" }
  /admin:
    get:
      tags: [p4-admin-shell-compat]
      operationId: getLegacyAdminShell
      summary: Render the frozen server-side Admin Shell shortcut page
      x-legacy-mapping-ids: [LEGACY-API-0001]
      x-p4-decision-evidence: P4-ADMIN-SHELL-AB-2026-08-16
      x-aicrm-capability: admin.shell.read
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: none
      x-aicrm-data-source: static
      x-aicrm-external-effect: none
      responses:
        "200": { description: Frozen server-rendered Admin Shell shortcut page, content: { text/html: { schema: { type: string } } } }
        "302": { description: "Missing, expired, malformed, or ambiguous browser session redirects to the local login path with next=/admin", headers: { Location: { required: true, schema: { type: string } } } }
        "403": { description: "Sales, unknown identity, bearer principal, or non-global grant is denied", content: { application/json: { schema: { $ref: "#/components/schemas/AdminShellAccessDenied" } } } }
        "503": { $ref: "#/components/responses/ServiceUnavailable" }
  /admin/logout:
    get:
      tags: [p4-admin-shell-compat]
      operationId: getLegacyAdminLogoutCompat
      summary: Redirect an authenticated Admin Shell browser to the existing logout owner
      x-legacy-mapping-ids: [LEGACY-API-0053]
      x-p4-decision-evidence: P4-ADMIN-SHELL-AB-2026-08-16
      x-aicrm-capability: admin.shell.read
      x-aicrm-rbac-scopes: { admin: global, ops: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-session-bound-csrf: none
      x-aicrm-data-source: static
      x-aicrm-external-effect: none
      responses:
        "302": { description: "Authenticated browser redirects exactly to /logout; a missing, expired, malformed, or ambiguous browser session redirects to the local login path with next=/admin/logout", headers: { Location: { required: true, schema: { type: string } } } }
        "403": { description: "Sales, unknown identity, bearer principal, or non-global grant is denied", content: { application/json: { schema: { $ref: "#/components/schemas/AdminShellAccessDenied" } } } }
        "503": { $ref: "#/components/responses/ServiceUnavailable" }
  /admin/api-docs:
    get:
      tags: [p4-api-docs-compat]
      operationId: getLegacyApiDocsPage
      summary: Render the frozen server-side API documentation page from the embedded canonical OpenAPI contract
      x-legacy-mapping-ids: [LEGACY-API-0003]
      x-p4-decision-evidence: P4-API-DOCS-0003-0033-R2-2026-08-18
      x-aicrm-capability: config.overview.read
      x-aicrm-rbac-scopes: { admin: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-data-classification: internal
      x-aicrm-session-bound-csrf: none
      x-aicrm-data-source: embedded_openapi
      x-aicrm-external-effect: none
      responses:
        "200": { description: Frozen server-rendered API documentation page, content: { text/html: { schema: { type: string } } } }
        "401": { $ref: "#/components/responses/Unauthorized" }
        "403": { $ref: "#/components/responses/Forbidden" }
        "500": { description: "Safe internal error envelope without spec, stack, or cause leakage", content: { application/json: { schema: { $ref: "#/components/schemas/ErrorResponse" } } } }
        "503": { $ref: "#/components/responses/ServiceUnavailable" }
  /admin/config/mcp-tools:
    get:
      tags: [p4-api-docs-compat]
      operationId: getLegacyMcpToolsRedirect
      summary: Redirect an authenticated Admin Config browser exactly to /admin/api-docs
      x-legacy-mapping-ids: [LEGACY-API-0033]
      x-p4-decision-evidence: P4-API-DOCS-0003-0033-R2-2026-08-18
      x-aicrm-capability: config.overview.read
      x-aicrm-rbac-scopes: { admin: global }
      x-aicrm-auth-scheme: human_session
      x-aicrm-data-classification: internal
      x-aicrm-session-bound-csrf: none
      x-aicrm-data-source: static
      x-aicrm-external-effect: none
      responses:
        "302": { description: "Authorized browser redirects exactly to /admin/api-docs with an empty body; the original query and body are never parsed, logged, or echoed", headers: { Location: { required: true, schema: { type: string } } } }
        "401": { $ref: "#/components/responses/Unauthorized" }
        "403": { $ref: "#/components/responses/Forbidden" }
        "503": { $ref: "#/components/responses/ServiceUnavailable" }
  /api/customers:
    get:
      tags: [p4-customer-compat]
      operationId: listLegacyCustomers
      summary: List the channel-neutral customer projection for the frozen old UI
      x-legacy-mapping-ids: [LEGACY-API-0609]
      x-p4-decision-evidence: P4-B01-2026-08-15
      x-aicrm-capability: customers.read
      x-aicrm-rbac-scopes: { admin: global, ops: global, sales: owner_staff }
      parameters:
        - { name: owner_userid, in: query, schema: { type: string } }
        - { name: tag, in: query, schema: { type: string } }
        - { name: status, in: query, schema: { type: string } }
        - { name: is_bound, in: query, schema: { type: string } }
        - { name: mobile, in: query, schema: { type: string } }
        - { name: keyword, in: query, schema: { type: string, maxLength: 200 } }
        - { name: limit, in: query, schema: { type: integer, minimum: 1, maximum: 200, default: 50 } }
        - { name: offset, in: query, schema: { type: integer, minimum: 0, maximum: 0, default: 0 } }
      responses:
        "200": { description: Frozen legacy customer list envelope, content: { application/json: { schema: { $ref: "#/components/schemas/LegacyCustomerListResponse" } } } }
        "400": { $ref: "#/components/responses/BadRequest" }
        "401": { $ref: "#/components/responses/Unauthorized" }
        "403": { $ref: "#/components/responses/Forbidden" }
        "503": { $ref: "#/components/responses/ServiceUnavailable" }
  /api/customers/{external_userid}:
    get:
      tags: [p4-customer-compat]
      operationId: getLegacyCustomer
      summary: Resolve a WeCom external identity and read its channel-neutral customer projection
      x-legacy-mapping-ids: [LEGACY-API-0619]
      x-p4-decision-evidence: P4-B01-2026-08-15
      x-aicrm-capability: customers.read
      x-aicrm-rbac-scopes: { admin: global, ops: global, sales: owner_staff }
      parameters:
        - { name: external_userid, in: path, required: true, schema: { type: string, minLength: 1, maxLength: 1024 } }
      responses:
        "200": { description: Frozen legacy customer detail envelope, content: { application/json: { schema: { $ref: "#/components/schemas/LegacyCustomerDetailResponse" } } } }
        "401": { $ref: "#/components/responses/Unauthorized" }
        "403": { $ref: "#/components/responses/Forbidden" }
        "404": { $ref: "#/components/responses/NotFound" }
        "503": { $ref: "#/components/responses/ServiceUnavailable" }
  /api/v1/customers:
    get:
      tags: [p3-contact]
      operationId: listCustomers
      summary: List customers using a keyset cursor
      x-p1-signoff-status: APPROVED
      x-p1-decision-evidence: G1-D01-2026-08-10
      x-legacy-mapping-ids: [LEGACY-API-0609]
      x-p3-decision-evidence: P3-C00-2026-08-12
      x-aicrm-capability: customers.read
      x-aicrm-rbac-scopes: { admin: global, ops: global, sales: owner_staff }
      parameters:
        - $ref: "#/components/parameters/Cursor"
        - $ref: "#/components/parameters/Limit"
        - $ref: "#/components/parameters/CustomerKeyword"
        - $ref: "#/components/parameters/OwnerStaffIDFilter"
        - $ref: "#/components/parameters/StageIDFilter"
        - $ref: "#/components/parameters/ChannelIDFilter"
        - $ref: "#/components/parameters/TagIDFilter"
        - $ref: "#/components/parameters/IsDeletedFilter"
        - $ref: "#/components/parameters/AddedAfterFilter"
        - $ref: "#/components/parameters/AddedBeforeFilter"
        - $ref: "#/components/parameters/LastInteractAfterFilter"
        - $ref: "#/components/parameters/LastInteractBeforeFilter"
      responses:
        "200":
          description: Customer page.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CustomerListResponse"
        "400": { $ref: "#/components/responses/BadRequest" }
        "401": { $ref: "#/components/responses/Unauthorized" }
        "403": { $ref: "#/components/responses/Forbidden" }
  /api/v1/customers/{customer_id}:
    parameters:
      - $ref: "#/components/parameters/CustomerID"
    get:
      tags: [p3-contact]
      operationId: getCustomer
      summary: Get a channel-neutral customer by OneID
      x-p1-signoff-status: APPROVED
      x-p1-decision-evidence: G1-D01-2026-08-10
      x-legacy-mapping-ids: [LEGACY-API-0619, LEGACY-API-0743]
      x-p3-decision-evidence: P3-C00-2026-08-12
      x-aicrm-capability: customers.read
      x-aicrm-rbac-scopes: { admin: global, ops: global, sales: owner_staff }
      responses:
        "200":
          description: Customer profile.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CustomerDetailResponse"
        "401": { $ref: "#/components/responses/Unauthorized" }
        "403": { $ref: "#/components/responses/Forbidden" }
        "404": { $ref: "#/components/responses/NotFound" }
    patch:
      tags: [p3-contact]
      operationId: updateCustomer
      summary: Update customer-owned profile fields
